{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "azain-media-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-08-21",
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "azain-media"
		}
	],
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true
		}
	}
}